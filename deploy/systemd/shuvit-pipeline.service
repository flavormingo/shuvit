[Unit]
Description=Shuvit Data Pipeline Scraper
After=network.target postgresql.service

[Service]
Type=oneshot
User=shuvit
Group=shuvit
WorkingDirectory=/opt/shuvit
EnvironmentFile=/opt/shuvit/backend/.env
ExecStart=/opt/shuvit/pipeline/.venv/bin/python -m pipeline.scraper.main scrape --source osm --world
MemoryMax=1G
Nice=10
StandardOutput=journal
StandardError=journal
