[Unit]
Description=Shuvit Data Pipeline Scraper
After=network.target postgresql.service

[Service]
Type=oneshot
User=shuvit
Group=shuvit
WorkingDirectory=/opt/shuvit
EnvironmentFile=/opt/shuvit/backend/.env
CacheDirectory=shuvit-tiles
ExecStart=/opt/shuvit/pipeline/.venv/bin/python -m pipeline.scraper.main scrape --source osm --world --cache-dir /var/cache/shuvit-tiles
MemoryMax=1G
Nice=10
StandardOutput=journal
StandardError=journal
