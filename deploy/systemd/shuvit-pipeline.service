[Unit]
Description=Shuvit Data Pipeline Scraper
After=network.target postgresql.service

[Service]
Type=oneshot
User=shuvit
Group=shuvit
# Must run from the parent of pipeline/ so that "pipeline" is importable.
WorkingDirectory=/opt/shuvit
EnvironmentFile=/opt/shuvit/backend/.env
ExecStart=/opt/shuvit/pipeline/.venv/bin/python -m pipeline.scraper.main scrape --source all
StandardOutput=journal
StandardError=journal
